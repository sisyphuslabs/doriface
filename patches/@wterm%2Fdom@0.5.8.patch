+// A part's html is its identity for diffing; its nodes are built here. A
+// Content-Security-Policy without 'unsafe-inline' drops style attributes parsed
+// from markup (so each run would lose its width and colors), but not styles
+// set through CSSOM.
+function cellSpanNode(doc, span) {
+    const element = doc.createElement("span");
+    if (span.className)
+        element.className = span.className;
+    if (span.style)
+        element.style.cssText = span.style;
+    if (span.strike) {
+        const strike = doc.createElement("span");
+        strike.style.cssText = "text-decoration:line-through solid currentColor;";
+        strike.textContent = span.text;
+        element.appendChild(strike);
+    }
+    else if (span.text) {
+        element.textContent = span.text;
+    }
+    return element;
+}
+function partNode(doc, part) {
+    if (!part.link)
+        return cellSpanNode(doc, part.span);
+    const link = doc.createElement("a");
+    link.className = "term-link";
+    link.setAttribute("href", part.link.href);
+    link.target = "_blank";
+    link.rel = "noopener noreferrer";
+    for (const span of part.link.spans)
+        link.appendChild(cellSpanNode(doc, span));
+    return link;
+}
