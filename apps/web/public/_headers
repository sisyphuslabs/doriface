# Response headers for the hosted web app (wrangler.jsonc). Workers static assets read this file and never serve it.

# Every page, the app shell for each client route included: revalidated on every load, and no-transform so the edge
# injects nothing into it (Web Analytics' automatic beacon would put a third-party script on /pair, whose URL fragment
# carries a pairing link's secret until the app takes it).
/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

# Hashed build output: a new build gets new names, so these never change in place.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The service worker and the manifest are revalidated on every load, so a release reaches an installed app through the
# worker's update prompt.
/sw.js
  ! Cache-Control
  Cache-Control: no-cache
/manifest.webmanifest
  ! Cache-Control
  Cache-Control: no-cache
  Content-Type: application/manifest+json
