{
  "$schema": "../../node_modules/app-builder-lib/scheme.json",
  "appId": "dev.omo.doriface",
  "productName": "doriface",
  "executableName": "doriface",
  "electronVersion": "45.2.1",
  "directories": { "output": "dist/release", "buildResources": "build-resources" },
  "files": ["dist/app/**", "package.json"],
  "extraResources": [
    { "from": "test-fixtures/web", "to": "web" },
    { "from": "dist/host/${os}-${arch}", "to": "bin" }
  ],
  "asar": true,
  "npmRebuild": false,
  "forceCodeSigning": false,
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] },
      { "target": "zip", "arch": ["arm64", "x64"] }
    ]
  },
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }]
  },
  "linux": {
    "category": "Development",
    "maintainer": "Sisyphus Labs",
    "target": [
      { "target": "AppImage", "arch": ["x64", "arm64"] },
      { "target": "deb", "arch": ["x64", "arm64"] }
    ]
  }
}
