# Response headers for doriterm.com (apps/landing/wrangler.jsonc). Workers static assets read this file and never serve it.

# Every response: revalidated on each load, and no-transform so the edge injects nothing into the page.
/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Hashed build output: a new build gets new names, so these never change in place.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The social card is referenced by absolute URL from other sites, so its name must not rotate with a build.
/og.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
